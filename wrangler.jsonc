{
  // Cloudflare Workers + static assets (new dashboard UI).
  // Build output lives in dist/; deploy with: npx wrangler deploy
  // Custom domains require the zone on Cloudflare first — see docs/GO_LIVE.md
  "name": "entermyuniverse",
  "compatibility_date": "2026-11-26",
  "workers_dev": true,
  "preview_urls": true,
  // Attach entermyuniverse.com / www in the Cloudflare dashboard after the
  // zone is Active (see docs/GO_LIVE.md). Do not add custom_domain routes here
  // until then — deploys fail if the zone is not on this Cloudflare account.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
