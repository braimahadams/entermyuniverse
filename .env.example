# ─────────────────────────────────────────────────────────────
#  ONE TALK — environment
#  Copy to `.env` and fill in. Everything with a FREE default
#  works with no card on file. Paid upgrades are one line each.
# ─────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────
# Your public URL. Used for Stripe redirects, webhooks, OG tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seeds the first admin account (that's you). Used once, by `npm run setup`.
# Change the password before running it.
OWNER_HANDLE="braimaadams"
OWNER_NAME="Braima Adams"
OWNER_PASSWORD="change-me-right-now"


# ── Uploads ───────────────────────────────────────────────────
# local = written to /public/media   (FREE — dev and self-hosted VPS only,
#         does NOT work on Vercel: read-only filesystem)
# blob  = Vercel Blob                (free tier, browser uploads direct)
STORAGE_PROVIDER="local"
# Created automatically when you add Blob storage in the Vercel dashboard.
# BLOB_READ_WRITE_TOKEN=""


# ── Platform economics ────────────────────────────────────────
# Your cut of each booking, in basis points. 1500 = 15%. Written onto each
# account at signup, so changing it never alters existing creators' terms.
PLATFORM_FEE_BPS="1500"


# ── Database ──────────────────────────────────────────────────
# FREE: SQLite file, zero setup. Great until you deploy.
DATABASE_URL="file:./dev.db"
# LATER (still free): Neon / Supabase Postgres.
#   1. Set DATABASE_URL to the Postgres connection string
#   2. In prisma/schema.prisma change provider = "postgresql"
#   3. npx prisma db push
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"


# ── Video hosting ─────────────────────────────────────────────
# local  = files you drop in /public/media          (FREE, ~0 setup)
# url    = any direct MP4/HLS link, e.g. R2 or Bunny (FREE-ish)
# mux    = Mux                                       (paid, best quality)
# stream = Cloudflare Stream                         ($5/mo per 1k min)
VIDEO_PROVIDER="local"
# MUX_TOKEN_ID=""
# MUX_TOKEN_SECRET=""
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_STREAM_TOKEN=""


# ── Live 1:1 meeting room ─────────────────────────────────────
# jitsi   = public Jitsi room, unique per booking   (FREE, unlimited)
# daily   = Daily.co                                (free 10k min/mo)
# manual  = you paste your own Zoom/Meet link       (FREE)
MEETING_PROVIDER="jitsi"
# DAILY_API_KEY=""
# Used when MEETING_PROVIDER="manual"
# MANUAL_MEETING_URL="https://meet.google.com/xxx-xxxx-xxx"


# ── Email ─────────────────────────────────────────────────────
# console = prints emails to your terminal          (FREE, dev)
# resend  = Resend                                  (free 3k/mo)
EMAIL_PROVIDER="console"
# RESEND_API_KEY=""
EMAIL_FROM="One Talk <hello@yourdomain.com>"
# Where booking notifications land (your inbox).
OWNER_EMAIL="you@yourdomain.com"


# ── Payments ──────────────────────────────────────────────────
# Stripe has no monthly fee — you only pay per transaction.
# Leave blank to run in "free mode": bookings are confirmed
# without payment, so you can test the whole flow end to end.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
CURRENCY="usd"
