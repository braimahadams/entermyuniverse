// ENTER MY UNIVERSE — data model
//
// A platform, not a personal site. Every piece of content belongs to a
// User. Anyone can sign up, claim a handle, and publish writing into
// their own universe at /@handle.
//
// Publishing is gated behind `approved` (see User below) and selling is
// gated behind `canSell` — both start false for everyone but the founding
// account. The whole marketplace — availability, pricing, Stripe Connect,
// the platform's cut — is modelled and working; it's just switched off
// until an account has earned the flag.
//
// Postgres (Neon/Supabase free tier both work). Vercel's serverless
// filesystem is read-only, which rules out SQLite in production — so dev
// and prod both point at the same kind of database, just different URLs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── PEOPLE ───────────────────────────────────────────────────

model User {
  id String @id @default(cuid())

  // The handle. Lowercase, unique, and the whole address of someone's
  // universe: entermyuniverse.com/@handle
  handle String @unique
  email  String @unique

  // scrypt, salted per user. See src/lib/auth.ts.
  passwordHash String

  displayName String
  // One line under the name on their universe page.
  tagline     String?
  bio         String?
  avatarUrl   String?
  // Wide image behind the header of their universe.
  bannerUrl   String?
  links       String? // newline-separated URLs

  // ── platform roles ──
  // Site-wide admin: moderation, granting canSell. That's you.
  isAdmin  Boolean @default(false)
  // Anyone can sign up, but a fresh account's writing stays off the public
  // feed and their own page shows empty until an admin flips this. Signup
  // itself is never blocked — only visibility is.
  approved Boolean @default(false)
  // Can this account take paid bookings? Off by default — content first,
  // commerce only once someone has earned it.
  canSell  Boolean @default(false)
  // Shown on the feed. Editorial control over what the front page looks like.
  featured Boolean @default(false)
  // Cosmetic tick. Trust signal, nothing more.
  verified Boolean @default(false)
  // Set by a moderator to hide everything this account has published.
  suspended Boolean @default(false)

  // ── money ──
  // Stripe Connect account, so payouts go to the creator and the platform
  // takes its cut atomically. Null until they onboard.
  stripeAccountId String?
  // True once Stripe says they can actually receive money.
  payoutsEnabled  Boolean @default(false)
  // Platform's cut in basis points. 1500 = 15%. Per-user so you can strike
  // a different deal with someone without a migration.
  platformFeeBps  Int     @default(1500)

  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts       Post[]
  sessionTypes SessionType[]
  availability AvailabilityRule[]
  blackouts    BlackoutDate[]
  sessions     Session[]
  // Bookings where this user is the one being booked.
  bookingsReceived Booking[] @relation("CreatorBookings")

  following Follow[] @relation("Follower")
  followers Follow[] @relation("Following")

  @@index([featured, createdAt])
  @@index([canSell])
  @@index([approved])
}

// Login sessions, stored server-side so they can be revoked — a signed
// cookie alone can't be taken away before it expires.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Follow {
  id String @id @default(cuid())

  followerId String
  follower   User   @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)

  followingId String
  following   User   @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

// ─── CONTENT ──────────────────────────────────────────────────

/**
 * A thought.
 *
 * Text, and only text. Video was tried and cut: it needed hosting,
 * storage, transcoding and a transcript before a single idea could go
 * out, and the result was that nothing went out at all. Writing has none
 * of that overhead, which is the only reason this gets used.
 */
model Post {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Unique per author, not globally — two people may both write something
  // called "the-system", and neither should have to rename it.
  slug String

  /** The writing. This is the post. */
  body String

  /**
   * The heading.
   *
   * Carries real weight now: the timeline shows a title and the opening
   * paragraph, and the title is what someone clicks. Still nullable, so a
   * one-line thought doesn't have to invent a heading for itself — the
   * opening words stand in when it's absent.
   */
  title String?

  /**
   * The question it deliberately leaves open. Shown at the end and carried
   * into the booking form as the topic — the hinge between reading and
   * booking. Optional, because most thoughts aren't sales pitches.
   */
  openQuestion String?

  /**
   * "Start here."
   *
   * The handful of thoughts worth meeting a stranger with. Set by hand:
   * there's no engagement data to infer it from, and inventing one would
   * turn this into the thing it's a reaction against.
   */
  pinned Boolean @default(false)

  /**
   * Who may read. "public" for now; "members" and "private" exist so a
   * future membership tier is a query filter rather than a migration.
   */
  visibility String @default("public")

  published Boolean @default(true)
  // Moderation. Anything false is hidden from public view.
  approved  Boolean @default(true)
  // Set by a moderator; explains a takedown to the author.
  moderationNote String?

  /**
   * When it went out, as distinct from when the row was created.
   * Separate so a post can be backdated or scheduled without lying about
   * its database history.
   */
  publishedAt DateTime @default(now())

  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings    Booking[]
  collections Collection[]
  comments    Comment[] @relation("PostComments")
  /** Comments elsewhere that point back at this post. */
  citedBy     Comment[] @relation("CommentCitation")

  @@unique([userId, slug])
  @@index([published, approved, publishedAt])
  @@index([userId, publishedAt])
  @@index([pinned])
}

/**
 * A reply.
 *
 * No account required — a name and the words. That's a deliberate trade:
 * a signup wall would cut replies to near zero on a site with no social
 * graph, and the cost of skipping it is spam, which `approved` handles by
 * defaulting to false. Nothing appears until it's been read.
 */
model Comment {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation("PostComments", fields: [postId], references: [id], onDelete: Cascade)

  authorName String
  /**
   * Optional and never displayed. Only so there's a way to reply to
   * someone who said something worth answering privately.
   */
  authorEmail String?

  body String

  /**
   * Another post this reply points at.
   *
   * Conversations here reach backwards — someone reads a thought from two
   * years ago and connects it to a recent one. Storing the link makes that
   * connection navigable instead of a date mentioned in prose.
   */
  citedPostId String?
  citedPost   Post?   @relation("CommentCitation", fields: [citedPostId], references: [id], onDelete: SetNull)

  /** False until read. Nothing is published on this site unseen. */
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([postId, approved, createdAt])
  @@index([approved, createdAt])
}

/**
 * A theme, not a folder.
 *
 * Content here is deliberately not browsed by date. Chronology implies a
 * feed, and a feed implies keeping up — which is the opposite of what this
 * is for. Ideas don't expire, so they're grouped by what they're about and
 * a thought can sit in several at once.
 *
 * Global rather than per-creator: the taxonomy is the site's, so the same
 * "Fear" means the same thing everywhere and collection pages stay
 * coherent if this ever reopens to other people.
 */
model Collection {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  position    Int     @default(0)

  posts Post[]

  @@index([position])
}

// ─── OFFERS ───────────────────────────────────────────────────

model SessionType {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  slug        String
  name        String
  tagline     String
  description String?
  includes    String? // newline-separated bullets

  durationMin Int
  // Minor units (cents), to keep money out of floating point.
  priceCents  Int
  currency    String @default("eur")

  bufferMin   Int @default(15)
  noticeHours Int @default(12)
  horizonDays Int @default(21)
  // Weekly cap. Real scarcity, and protection from your own calendar.
  maxPerWeek  Int @default(6)

  active   Boolean @default(true)
  position Int     @default(0)

  bookings Booking[]

  @@unique([userId, slug])
  @@index([userId, active, position])
}

// ─── AVAILABILITY ─────────────────────────────────────────────

model AvailabilityRule {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 0 = Sunday ... 6 = Saturday
  weekday  Int
  // Minutes from local midnight. 540 = 09:00.
  startMin Int
  endMin   Int
  timezone String  @default("UTC")
  active   Boolean @default(true)

  @@index([userId, active, weekday])
}

model BlackoutDate {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  startsAt DateTime
  endsAt   DateTime
  reason   String?

  @@index([userId, startsAt, endsAt])
}

// ─── BOOKINGS ─────────────────────────────────────────────────

// Status is a String because SQLite has no enum type. Allowed values are
// a typed union in src/lib/constants.ts:
//   PENDING | CONFIRMED | CANCELLED | COMPLETED | NO_SHOW

model Booking {
  id        String @id @default(cuid())
  reference String @unique

  // Who is being booked.
  creatorId String
  creator   User   @relation("CreatorBookings", fields: [creatorId], references: [id])

  sessionTypeId String
  sessionType   SessionType @relation(fields: [sessionTypeId], references: [id])

  // Which thought sent them. Tells the author what actually converts.
  sourcePostId String?
  sourcePost   Post?   @relation(fields: [sourcePostId], references: [id], onDelete: SetNull)

  // The guest books by email — no account required. Forcing a signup
  // between wanting a call and paying for one loses bookings.
  name     String
  email    String
  topic    String
  context  String?
  timezone String  @default("UTC")

  startsAt DateTime
  endsAt   DateTime

  status        String    @default("PENDING")
  holdExpiresAt DateTime?

  // ── money ──
  amountCents Int
  currency    String @default("eur")
  // The platform's share of amountCents, frozen at booking time so a later
  // fee change never rewrites history.
  platformFeeCents Int @default(0)

  stripeSessionId String? @unique
  stripePaymentId String?
  paidAt          DateTime?

  meetingUrl      String?
  meetingProvider String?
  // Secret in the guest's manage/join link.
  accessToken String @unique @default(cuid())

  remindedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([creatorId, startsAt, status])
  @@index([startsAt, status])
  @@index([email])
}

// ─── AUDIENCE ─────────────────────────────────────────────────

model Waitlist {
  id String @id @default(cuid())

  email String
  name  String?
  // Null = the platform's own list. Set = this creator's list.
  creatorId String?
  interest  String?
  source    String?
  createdAt DateTime @default(now())

  // Someone may join the platform list and a specific creator's list.
  @@unique([email, creatorId])
}
